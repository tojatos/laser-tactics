FROM node:18.20.8 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install
RUN npm install -g @angular/cli@~12.2.3
COPY . .

RUN ng build --prod

FROM nginx:1.21.3
COPY --from=build /app/dist/laser-chess-frontend/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
